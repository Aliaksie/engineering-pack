#!/bin/sh
# Generated by the export build. Runs this package's bundled native runtime.
here=${0%/*}
# Commands that account installed guidance (the status line) read this package's root.
CRAFT_PACKAGE_ROOT=$here/..
export CRAFT_PACKAGE_ROOT
if [ -n "$OSTYPE" ] && [ -n "$HOSTTYPE" ]; then platform="$OSTYPE:$HOSTTYPE"; else platform=$(uname -sm 2>/dev/null); fi
case $platform in
  'Linux x86_64'|linux*:x86_64) binary="$here/../support/native-bin/x86_64-unknown-linux-gnu/native-bin/craft" ;;
  'Linux aarch64'|linux*:aarch64) binary="$here/../support/native-bin/aarch64-unknown-linux-gnu/native-bin/craft" ;;
  'Darwin arm64'|darwin*:arm64) binary="$here/../support/native-bin/aarch64-apple-darwin/native-bin/craft" ;;
  MINGW*' x86_64'|MSYS*' x86_64'|CYGWIN*' x86_64'|msys:x86_64|cygwin:x86_64) binary="$here/../support/native-bin/x86_64-pc-windows-msvc/native-bin/craft.exe" ;;
  *) binary= ;;
esac
# A development build, as for the other runtime entry points.
[ -n "$CRAFT_NATIVE_BINARY" ] && binary=$CRAFT_NATIVE_BINARY
# The hook command already ran it and it failed: answer without starting it again.
[ -n "$CRAFT_NATIVE_FAILED" ] && binary=
if [ -n "$binary" ] && [ -f "$binary" ]; then
  [ -x "$binary" ] || chmod u+x "$binary" 2>/dev/null
  "$binary" "$@"
  status=$?
  # The runtime exits 0-2; anything else means it could not start or crashed.
  [ "$status" -le 2 ] && exit "$status"
fi
# No working bundled runtime: deny shell policy, say once at session start that it is inactive.
case "$1 $2 $3 $7" in
  'hook claude session-start observe') printf '%s\n' '{"systemMessage":"craft-stories is inactive: its bundled native runtime is missing or cannot start here (built for linux x64, linux arm64, darwin arm64, win32 x64). Its hooks, routing, checkpoints and telemetry are off; reinstall it or use a supported platform.","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"craft-stories is inactive: its bundled native runtime is missing or cannot start here (built for linux x64, linux arm64, darwin arm64, win32 x64). Its hooks, routing, checkpoints and telemetry are off; reinstall it or use a supported platform."}}'; exit 0 ;;
  'hook claude after-compact observe') printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"craft-stories is inactive: its bundled native runtime is missing or cannot start here (built for linux x64, linux arm64, darwin arm64, win32 x64). Its hooks, routing, checkpoints and telemetry are off; reinstall it or use a supported platform."}}'; exit 0 ;;
  'hook '*) exit 0 ;;
esac
printf '%s\n' 'craft: bundled native runtime unavailable' >&2
exit 1
