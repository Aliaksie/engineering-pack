                    },
                    "additionalProperties": false,
                    "required": [
                      "tool",
                      "arguments"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "provider",
                "transport"
              ]
            }
          ]
        },
        "tasks": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "transport": {
                  "const": "cli"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "git.status",
                      "git.diff",
                      "change.read",
                      "change.diff",
                      "task.read",
                      "task.search",
                      "git.commit",
                      "git.push",
                      "change.publish",
                      "task.transition",
                      "task.comment"
