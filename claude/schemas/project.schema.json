                    "type": "object",
                    "properties": {
                      "tool": {
                        "type": "string",
                        "minLength": 1
                      },
                      "arguments": {
                        "type": "object"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "tool",
                      "arguments"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "provider",
                "transport"
              ]
            }
          ]
