                "java",
                "kotlin"
              ]
            }
          },
          "layers": {
            "type": "array",
            "items": {
              "enum": [
                "ui",
                "backend",
                "agent"
              ]
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
