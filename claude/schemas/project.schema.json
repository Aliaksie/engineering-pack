                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "git.status",
                      "git.diff",
                      "change.read",
                      "change.diff",
                      "task.read",
                      "task.search",
                      "git.commit",
                      "git.push",
                      "change.publish",
                      "task.transition",
                      "task.comment"
