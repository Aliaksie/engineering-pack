            "enum": [
              "git.commit",
              "git.push",
              "change.publish",
              "task.transition",
              "task.comment"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "execution": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "object",
          "properties": {
            "locator": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "main",
                    "delegate",
                    "tool"
                  ]
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "mode"
              ]
            },
            "researcher": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "main",
                    "delegate",
                    "tool"
                  ]
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "mode"
              ]
            },
            "implementer": {
              "type": "object",
