{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consumer project configuration v1",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "languages": {
      "type": "array",
      "items": {
        "enum": [
          "javascript",
          "typescript",
          "python",
          "jvm",
          "csharp",
          "go",
          "java",
          "kotlin"
        ]
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "enum": [
          "ui",
          "backend",
          "agent"
        ]
      }
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$"
