{
  "formatVersion": 1,
  "description": "Unfamiliar-repository lookup probes: public repositories at frozen commits, one question per task, deterministic ground truth checked against that commit.",
  "repositories": {
    "chi": { "url": "https://github.com/go-chi/chi", "commit": "9f8adb1aabaa8a91180a821111d3f8e668d1c0bf", "language": "go" },
    "gson": { "url": "https://github.com/google/gson", "commit": "57731049da3e415be3d5d34db1ca3b80f3c73810", "language": "java" },
    "hono": { "url": "https://github.com/honojs/hono", "commit": "c91b60a251186fb024557c6d55a11d8e388f179c", "language": "typescript" },
    "httpx": { "url": "https://github.com/encode/httpx", "commit": "b5addb64f0161ff6bfe94c124ef76f6a1fba5254", "language": "python" },
    "log4brains": { "url": "https://github.com/thomvaill/log4brains", "commit": "17e32021a8c5130386f17e921d4efa6da7709a66", "language": "docs" },
    "ripgrep": { "url": "https://github.com/BurntSushi/ripgrep", "commit": "91f5d22ef48bde459d90a8c7dbeab416e97d0f2b", "language": "rust" }
  },
  "probes": [
    { "id": "chi-declaration", "repository": "chi", "actor": "developer", "kind": "declaration", "format": "path",
      "question": "Which file declares `NewWrapResponseWriter`, the wrapper that records the status code and bytes written by a handler?",
      "expected": ["middleware/wrap_writer.go"] },
    { "id": "chi-callers", "repository": "chi", "actor": "developer", "kind": "callers", "format": "symbol",
      "question": "Which functions or methods call `RouteContext` directly? Leave out tests and the `_examples` directory.",
      "expected": ["context.go#URLParamFromCtx", "mux.go#Mount", "middleware/strip.go#StripSlashes", "middleware/strip.go#RedirectSlashes",
        "middleware/get_head.go#GetHead", "middleware/supress_notfound.go#SupressNotFound", "middleware/clean_path.go#CleanPath",
        "middleware/url_format.go#URLFormat"] },
    { "id": "chi-change-impact", "repository": "chi", "actor": "reviewer", "kind": "change-impact", "format": "path",
      "question": "A pull request changes the signature of `NewWrapResponseWriter`. Which files outside tests and the `_examples` directory must change with it?",
      "expected": ["middleware/wrap_writer.go", "middleware/logger.go"] },
    { "id": "chi-owner", "repository": "chi", "actor": "architect", "kind": "owner", "format": "path",
      "question": "Which file implements the radix tree the router uses to match request paths to routes?",
      "expected": ["tree.go"] },
    { "id": "chi-interface", "repository": "chi", "actor": "architect", "kind": "declaration", "format": "path",
      "question": "Which file declares the `Router` interface that the multiplexer implements?",
      "expected": ["chi.go"] },
    { "id": "chi-tested", "repository": "chi", "actor": "qa", "kind": "tested-where", "format": "path",
      "question": "Which test file checks that a request path with a trailing slash is redirected to the path without it?",
      "expected": ["middleware/strip_test.go"] },

    { "id": "gson-declaration", "repository": "gson", "actor": "developer", "kind": "declaration", "format": "path",
      "question": "Which file declares the type adapter Gson uses to convert Java enums to and from JSON?",
      "expected": ["gson/src/main/java/com/google/gson/internal/bind/EnumTypeAdapter.java"] },
    { "id": "gson-callers", "repository": "gson", "actor": "developer", "kind": "callers", "format": "symbol",
      "question": "Which methods call `ConstructorConstructor.checkInstantiable` directly?",
      "expected": ["gson/src/main/java/com/google/gson/internal/UnsafeAllocator.java#assertInstantiable",
        "gson/src/main/java/com/google/gson/internal/ConstructorConstructor.java#get"] },
    { "id": "gson-dependents", "repository": "gson", "actor": "reviewer", "kind": "change-impact", "format": "path",
      "question": "A change to the core `gson` artifact affects every Maven module that depends on it. Which modules' `pom.xml` files declare that dependency?",
      "expected": ["extras/pom.xml", "metrics/pom.xml", "proto/pom.xml", "test-graal-native-image/pom.xml", "test-jpms/pom.xml", "test-shrinker/pom.xml"] },
    { "id": "gson-owner", "repository": "gson", "actor": "architect", "kind": "owner", "format": "path",
      "question": "Which class decides whether a field or class is skipped during serialization and deserialization (for example by `@Expose`, `@Since` or modifiers)?",
      "expected": ["gson/src/main/java/com/google/gson/internal/Excluder.java"] },
    { "id": "gson-decision-doc", "repository": "gson", "actor": "architect", "kind": "decision", "format": "path",
      "question": "Which document explains why Gson reports parse errors with unchecked exceptions rather than checked ones?",
      "expected": ["GsonDesignDocument.md"] },
    { "id": "gson-tested", "repository": "gson", "actor": "qa", "kind": "tested-where", "format": "path", "match": "any",
      "question": "Which test file checks whether the `java.sql` date and time types are detected as available at runtime?",
      "expected": ["gson/src/test/java/com/google/gson/internal/sql/SqlTypesSupportTest.java"],
      "allowed": ["gson/src/test/java/com/google/gson/internal/sql/SqlTypesGsonTest.java"] },

    { "id": "hono-declaration", "repository": "hono", "actor": "developer", "kind": "declaration", "format": "path",
      "question": "Which file declares `HTTPException`?",
      "expected": ["src/http-exception.ts"] },
    { "id": "hono-callers", "repository": "hono", "actor": "developer", "kind": "callers", "format": "symbol",
      "question": "Which functions call `timingSafeEqual` directly? Leave out tests.",
      "expected": ["src/middleware/bearer-auth/index.ts#bearerAuth", "src/middleware/basic-auth/index.ts#basicAuth"] },
    { "id": "hono-importers", "repository": "hono", "actor": "reviewer", "kind": "change-impact", "format": "path",
      "question": "A pull request changes the exports of `src/utils/buffer.ts`. Which source files, not tests, import from it?",
      "expected": ["src/utils/body.ts", "src/validator/validator.ts", "src/middleware/basic-auth/index.ts", "src/middleware/bearer-auth/index.ts"] },
    { "id": "hono-owner", "repository": "hono", "actor": "architect", "kind": "owner", "format": "path", "match": "any",
      "question": "Which file decides which router implementation the default `Hono` class uses?",
      "expected": ["src/hono.ts"],
      "allowed": ["src/router/smart-router/router.ts", "src/router/smart-router/index.ts"] },
    { "id": "hono-tested", "repository": "hono", "actor": "qa", "kind": "tested-where", "format": "path",
      "question": "Which test file holds the shared cases every router implementation must pass?",
      "expected": ["src/router/common.case.test.ts"] },
    { "id": "hono-migration-doc", "repository": "hono", "actor": "architect", "kind": "decision", "format": "path",
      "question": "Which document tells users what to do now that `StaticRouter` is obsolete?",
      "expected": ["docs/MIGRATION.md"] },

    { "id": "httpx-declaration", "repository": "httpx", "actor": "developer", "kind": "declaration", "format": "path",
      "question": "Which file declares the `Timeout` configuration class?",
      "expected": ["httpx/_config.py"] },
    { "id": "httpx-callers", "repository": "httpx", "actor": "developer", "kind": "callers", "format": "symbol",
      "question": "Which functions or methods call `primitive_value_to_str` directly?",
      "expected": ["httpx/_content.py#encode_urlencoded_data", "httpx/_multipart.py#__init__", "httpx/_urls.py#__init__",
        "httpx/_urls.py#set", "httpx/_urls.py#add"] },
    { "id": "httpx-importers", "repository": "httpx", "actor": "reviewer", "kind": "change-impact", "format": "path",
      "question": "A pull request changes the private URL parser in `httpx/_urlparse.py`. Which other modules of the `httpx` package import it?",
      "expected": ["httpx/_urls.py"] },
    { "id": "httpx-owner", "repository": "httpx", "actor": "architect", "kind": "owner", "format": "path", "match": "any",
      "question": "Which file contains the code that reads proxy settings from environment variables?",
      "expected": ["httpx/_utils.py"],
      "allowed": ["httpx/_client.py"] },
    { "id": "httpx-tested", "repository": "httpx", "actor": "qa", "kind": "tested-where", "format": "path",
      "question": "Which test file checks that an `Authorization` header is dropped when a redirect goes to a different domain?",
      "expected": ["tests/client/test_redirects.py"] },
    { "id": "httpx-doc", "repository": "httpx", "actor": "architect", "kind": "documentation", "format": "path",
      "question": "Which documentation page explains how to configure connection pool limits?",
      "expected": ["docs/advanced/resource-limits.md"] },

    { "id": "log4brains-current-id-decision", "repository": "log4brains", "actor": "architect", "kind": "decision", "format": "path",
      "question": "Which architecture decision record is the current decision on how an ADR is uniquely identified?",
      "expected": ["docs/adr/20201016-use-the-adr-slug-as-its-unique-id.md"] },
    { "id": "log4brains-current-branching", "repository": "log4brains", "actor": "architect", "kind": "decision", "format": "path",
      "question": "Which architecture decision record holds the project's current Git branching workflow?",
      "expected": ["docs/adr/20241217-switch-back-to-github-flow.md"] },
    { "id": "log4brains-web-react", "repository": "log4brains", "actor": "architect", "kind": "decision", "format": "path",
      "question": "Which architecture decision records govern how the React code of the web package is written and organized?",
      "expected": ["packages/web/docs/adr/20200926-react-file-structure-organized-by-feature.md", "packages/web/docs/adr/20200927-avoid-react-fc-type.md",
        "packages/web/docs/adr/20200927-use-react-hooks.md", "packages/web/docs/adr/20201007-next-js-persistent-layout-pattern.md"],
      "allowed": ["packages/web/docs/adr/20200925-use-nextjs-for-static-site-generation.md", "docs/adr/20200925-use-prettier-eslint-airbnb-for-the-code-style.md",
        "docs/adr/20200927-avoid-default-exports.md"] },
    { "id": "log4brains-declaration", "repository": "log4brains", "actor": "developer", "kind": "declaration", "format": "path",
      "question": "Which file models an ADR's status (draft, proposed, accepted, superseded and so on) in the core package?",
      "expected": ["packages/core/src/adr/domain/AdrStatus.ts"] },
    { "id": "log4brains-slug-impact", "repository": "log4brains", "actor": "reviewer", "kind": "change-impact", "format": "path",
      "question": "A pull request changes `AdrSlug`. Which non-test files under `packages/core/src` use it, apart from the file that declares it?",
      "expected": ["packages/core/src/adr/application/commands/CreateAdrFromTemplateCommand.ts", "packages/core/src/adr/application/commands/SupersedeAdrCommand.ts",
        "packages/core/src/adr/application/queries/GetAdrBySlugQuery.ts", "packages/core/src/adr/application/query-handlers/GenerateAdrSlugFromTitleCommandHandler.ts",
        "packages/core/src/adr/application/repositories/AdrRepository.ts", "packages/core/src/adr/domain/Adr.ts", "packages/core/src/adr/domain/AdrFile.ts",
        "packages/core/src/adr/domain/AdrTemplate.ts", "packages/core/src/adr/domain/index.ts", "packages/core/src/adr/infrastructure/repositories/AdrRepository.ts",
        "packages/core/src/infrastructure/api/Log4brains.ts"] },
    { "id": "log4brains-tested", "repository": "log4brains", "actor": "qa", "kind": "tested-where", "format": "path", "match": "any",
      "question": "Which test file covers reading and adding links in an ADR's Markdown body?",
      "expected": ["packages/core/src/adr/domain/MarkdownBody.test.ts"],
      "allowed": ["packages/core/src/adr/domain/MarkdownAdrLink.test.ts", "packages/core/src/adr/domain/Adr.test.ts"] },

    { "id": "ripgrep-declaration", "repository": "ripgrep", "actor": "developer", "kind": "declaration", "format": "path",
      "question": "Which file declares `WalkBuilder`, the builder for recursive directory traversal?",
      "expected": ["crates/ignore/src/walk.rs"] },
    { "id": "ripgrep-callers", "repository": "ripgrep", "actor": "developer", "kind": "callers", "format": "symbol",
      "question": "Which functions call `is_hidden_path` or `is_hidden_entry` directly? Leave out tests.",
      "expected": ["crates/ignore/src/incremental.rs#matched_with_errors_ignore", "crates/ignore/src/incremental.rs#match_path",
        "crates/ignore/src/dir.rs#matched_dir_entry"] },
    { "id": "ripgrep-dependents", "repository": "ripgrep", "actor": "reviewer", "kind": "change-impact", "format": "path",
      "question": "A pull request changes the public API of the `grep-searcher` crate. Which crates' `Cargo.toml` files depend on it?",
      "expected": ["crates/grep/Cargo.toml", "crates/printer/Cargo.toml"] },
    { "id": "ripgrep-owner", "repository": "ripgrep", "actor": "architect", "kind": "owner", "format": "path",
      "question": "Which file implements the standard, grep-like output format for search results?",
      "expected": ["crates/printer/src/standard.rs"] },
    { "id": "ripgrep-tested", "repository": "ripgrep", "actor": "qa", "kind": "tested-where", "format": "path",
      "question": "Which integration test file covers how ripgrep handles binary files?",
      "expected": ["tests/binary.rs"] },
    { "id": "ripgrep-doc", "repository": "ripgrep", "actor": "architect", "kind": "documentation", "format": "path", "match": "any",
      "question": "Which document explains to users how automatic filtering works (ignore files, hidden files and binary files)?",
      "expected": ["GUIDE.md"],
      "allowed": ["README.md", "FAQ.md"] }
  ]
}
