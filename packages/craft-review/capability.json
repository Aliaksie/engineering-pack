{
  "formatVersion": 1,
  "name": "craft-review",
  "version": "0.0.2",
  "description": "Headless, revision-bound review for local diffs, GitHub PRs and GitLab MRs.",
  "author": {
    "name": "craft-capabilities contributors"
  },
  "instructions": "AGENTS.md",
  "skills": [
    "skills/review-change"
  ],
  "workflows": [
    "workflows/review-change.md"
  ],
  "standards": [],
  "evals": [
    "evals/draft-only.json"
  ],
  "tools": [
    {
      "name": "prepare-review",
      "command": "review-prepare",
      "runtime": "native",
      "network": "none"
    },
    {
      "name": "check-review",
      "command": "review-check",
      "runtime": "native",
      "network": "none"
    },
    {
      "name": "plan-publication",
      "command": "review-publication",
      "runtime": "native",
      "network": "none"
    },
    {
      "name": "check-followup",
      "command": "review-followup",
      "runtime": "native",
      "network": "none"
    }
  ],
  "hooks": [
    {
      "name": "read-only",
      "event": "before-tool",
      "tool": "shell",
      "handler": "review-read-only"
    },
    {
      "name": "observe-session-start",
      "event": "session-start",
      "tool": "any",
      "handler": "observe"
    },
    {
      "name": "observe-before-prompt",
      "event": "before-prompt",
      "tool": "any",
      "handler": "observe"
    },
    {
      "name": "observe-before-tool",
      "event": "before-tool",
      "tool": "any",
      "handler": "observe"
    },
    {
      "name": "observe-after-tool",
      "event": "after-tool",
      "tool": "any",
      "handler": "observe"
    },
    {
      "name": "observe-before-compact",
      "event": "before-compact",
      "tool": "any",
      "handler": "observe"
    },
    {
      "name": "observe-after-compact",
      "event": "after-compact",
      "tool": "any",
      "handler": "observe"
    },
    {
      "name": "observe-turn-end",
      "event": "turn-end",
      "tool": "any",
      "handler": "observe"
    }
  ],
  "mcp": [],
  "optionalDependencies": [
    "craft-engineering",
    "craft-delivery"
  ]
}
