        "craft-delivery-configure-service",
        "craft-delivery-workflow-deliver-change",
        "craft-delivery-workflow-ship-change"
      ],
      "workflows": "exported-as-skills",
      "instructions": "AGENTS.md-linked-from-skills",
      "standards": "included-on-demand",
      "evals": "included-not-executed",
      "tools": "included-not-executed",
      "hooks": "native-before-tool-requires-trust",
      "mcp": "none",
      "hookMappings": [
        {
          "id": "routing",
          "normalizedEvent": "before-tool",
          "name": "PreToolUse",
          "context": true,
          "deny": true,
          "event": "before-tool",
          "tool": "any",
          "handler": "hooks/context.mjs"
        },
        {
          "id": "prompt-routing",
          "normalizedEvent": "before-prompt",
          "name": "UserPromptSubmit",
          "context": true,
          "deny": false,
          "event": "before-prompt",
          "tool": "any",
          "handler": "hooks/context.mjs"
        },
        {
          "id": "restore",
          "normalizedEvent": "session-start",
          "name": "SessionStart",
          "context": true,
          "deny": false,
          "matcher": "startup|resume",
          "event": "session-start",
          "tool": "any",
          "handler": "hooks/context.mjs"
        },
        {
          "id": "checkpoint",
          "normalizedEvent": "before-compact",
          "name": "PreCompact",
          "context": false,
          "deny": false,
          "event": "before-compact",
          "tool": "any",
          "handler": "hooks/context.mjs"
        },
        {
          "id": "milestone",
          "normalizedEvent": "after-tool",
          "name": "PostToolUse",
          "context": true,
          "deny": false,
          "event": "after-tool",
          "tool": "any",
          "handler": "hooks/context.mjs"
        },
        {
          "id": "turn-checkpoint",
          "normalizedEvent": "turn-end",
          "name": "Stop",
          "context": false,
          "deny": false,
          "event": "turn-end",
          "tool": "any",
          "handler": "hooks/context.mjs"
        },
        {
          "id": "compact-restore",
          "normalizedEvent": "after-compact",
          "name": "SessionStart",
          "context": true,
          "deny": false,
          "matcher": "compact",
          "event": "after-compact",
          "tool": "any",
          "handler": "hooks/context.mjs"
        }
      ],
      "runtime": "support/cli/main.mjs",
      "sessionAdvice": {
        "entry": "support/session.mjs",
        "observation": "native-ui-only; no stable usage field in mapped hooks",
        "display": "native /statusline; explicit CLI advice fallback",
        "commands": {
          "inspectUsage": "/statusline",
          "compact": "/compact",
          "start-new-session": "/new"
        },
        "activation": "explicit-only; no statusline settings or hooks changed"
      },
      "limitations": [
        "Local plugin export; hooks require host support and trust. Live host loading has not been tested."
      ]
    },
