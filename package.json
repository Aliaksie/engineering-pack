{
  "name": "craft-capabilities",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "Portable AI capability packages: workflows, standards, skills, evals, tools and MCP with host adapters",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node tooling/validate-capabilities.mjs",
    "validate:claude": "claude plugin validate ./dist/claude --strict",
    "lint:scripts": "node tooling/lint-plugin-scripts.mjs",
    "lint:workflows": "actionlint",
    "test:workflows": "node --test tooling/workflow-lint.test.mjs",
    "test": "node tooling/run-tests.mjs",
    "sync:craft-bar": "node tooling/sync-craft-bar.mjs",
    "check": "npm run validate && npm run check:craft-bar && npm run build && npm run build:distribution && npm run architecture && npm run validate:exports && npm run lint:scripts && npm run test:unit",
    "check:craft-bar": "node tooling/sync-craft-bar.mjs --check",
    "build": "node tooling/build.mjs",
    "build:native": "node tooling/native-bundle.mjs",
    "build:claude": "node tooling/build.mjs claude",
    "build:codex": "node tooling/build.mjs codex",
    "build:agents": "node tooling/build.mjs agents",
    "validate:exports": "node tooling/validate-marketplace.mjs dist/claude",
    "architecture": "node tooling/architecture.mjs",
    "pretest": "npm run build && npm run build:distribution",
    "eval:report": "node tooling/eval-report.mjs",
    "route": "node tooling/craft.mjs route",
    "operation": "node tooling/craft.mjs operation",
    "checkpoint:save": "node tooling/craft.mjs checkpoint-save",
    "checkpoint:read": "node tooling/craft.mjs checkpoint-read",
    "build:cursor": "node tooling/build.mjs cursor",
    "build:copilot": "node tooling/build.mjs copilot",
    "build:gemini": "node tooling/build.mjs gemini",
    "test:unit": "node tooling/run-tests.mjs",
    "hooks:report": "node tooling/hook-report.mjs",
    "locate": "node tooling/craft.mjs locate",
    "services:prepare": "node tooling/craft.mjs prepare-services",
    "build:distribution": "node tooling/distribution.mjs",
    "context:report": "node tooling/craft.mjs context-report",
    "session": "node tooling/craft.mjs session",
    "telemetry:report": "node tooling/craft.mjs telemetry-report",
    "telemetry:capture": "node tooling/craft.mjs telemetry-capture",
    "telemetry:forget": "node tooling/craft.mjs telemetry-forget",
    "session:attempt": "node tooling/craft.mjs session-attempt",
    "session:advice": "node tooling/craft.mjs session-advice",
    "acceptance:view": "node tooling/craft.mjs acceptance-view",
    "model:advice": "node tooling/craft.mjs model-advice",
    "version:sync": "node tooling/version.mjs",
    "version:check": "node tooling/version.mjs --check"
  },
  "license": "MIT"
}
