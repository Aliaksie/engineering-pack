{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consumer project configuration v1",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "languages": {
      "type": "array",
      "items": {
        "enum": [
          "javascript",
          "typescript",
          "python",
          "jvm",
          "csharp",
          "go",
          "java",
          "kotlin",
          "rust",
          "ruby"
        ]
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "enum": [
          "ui",
          "backend",
          "agent"
        ]
      }
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "languages": {
            "type": "array",
            "items": {
              "enum": [
                "javascript",
                "typescript",
                "python",
                "jvm",
                "csharp",
                "go",
                "java",
                "kotlin",
                "rust",
                "ruby"
              ]
            }
          },
          "layers": {
            "type": "array",
            "items": {
              "enum": [
                "ui",
                "backend",
                "agent"
              ]
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "frameworks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "command"
              ]
            }
          },
          "runtimes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "path"
        ]
      }
    },
    "standards": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64,
            "description": "Stable handle shown in routes and check results."
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "Project-relative file holding the standard."
          },
          "folder": {
            "type": "string",
            "minLength": 1,
            "description": "Project-relative folder of standard documents."
          },
          "anchor": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "An established standard by name: a Semantic Anchors catalog id, a Craft alias such as semver, or an id from the project's anchor catalogs. Names with a Craft check are checked deterministically; others are advised or reviewed."
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "One line shown in routes instead of the standard's content."
          },
          "level": {
            "enum": [
              "advise",
              "check",
              "review"
            ],
            "description": "advise: named when work reaches the scope; check: an anchor check or a run command; review: a checklist. Defaults from the declaration's form."
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "modules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "languages": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "javascript",
                    "typescript",
                    "python",
                    "jvm",
                    "csharp",
                    "go",
                    "java",
                    "kotlin",
                    "rust",
                    "ruby"
                  ]
                }
              },
              "layers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "ui",
                    "backend",
                    "agent"
                  ]
                }
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "intents": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Kinds of work: story, plan, verify, explore, review, implement and the other routing intents."
              }
            },
            "description": "Where the standard applies; all keys must match, any value within a key. Absent: the whole project."
          },
          "run": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "A consumer command the agent is told to run to check the standard."
          },
          "checklist": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      },
      "description": "Project standards: consumer-owned declarations routed by scope and, for anchors, checked without a model."
    },
    "anchors": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the project's own anchors come from and which Craft defaults apply. A project entry replaces the built-in entry with the same id.",
      "properties": {
        "catalogs": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Project-relative anchor catalog files, read in order; a later file wins on the same id. Each holds {\"anchors\": [{id, title?, summary?, checklist?, check?, intents?, targets?}]}."
        },
        "defaults": {
          "type": "boolean",
          "description": "Whether Craft's anchor defaults for the kind of work apply."
        },
        "disables": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "description": "Anchors Craft must not add as defaults."
        }
      }
    },
    "services": {
      "type": "object",
      "properties": {
        "git": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "transport": {
                  "const": "cli"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "git.status",
                      "git.diff",
                      "change.read",
                      "change.diff",
                      "task.read",
                      "task.search",
                      "git.commit",
                      "git.push",
                      "change.publish",
                      "task.transition",
                      "task.comment"
                    ]
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "args": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "args"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "provider",
                "transport",
                "command"
              ]
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "transport": {
                  "const": "mcp"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "git.status",
                      "git.diff",
                      "change.read",
                      "change.diff",
                      "task.read",
                      "task.search",
                      "git.commit",
                      "git.push",
                      "change.publish",
                      "task.transition",
                      "task.comment"
                    ]
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "type": "string",
                        "minLength": 1
                      },
                      "arguments": {
                        "type": "object"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "tool",
                      "arguments"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "provider",
                "transport"
              ]
            }
          ]
        },
        "codehost": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "transport": {
                  "const": "cli"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "git.status",
                      "git.diff",
                      "change.read",
                      "change.diff",
                      "task.read",
                      "task.search",
                      "git.commit",
                      "git.push",
                      "change.publish",
                      "task.transition",
                      "task.comment"
                    ]
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "args": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "args"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "provider",
                "transport",
                "command"
              ]
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "transport": {
                  "const": "mcp"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "git.status",
                      "git.diff",
                      "change.read",
                      "change.diff",
                      "task.read",
                      "task.search",
                      "git.commit",
                      "git.push",
                      "change.publish",
                      "task.transition",
                      "task.comment"
                    ]
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "type": "string",
                        "minLength": 1
                      },
                      "arguments": {
                        "type": "object"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "tool",
                      "arguments"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "provider",
                "transport"
              ]
            }
          ]
        },
        "tasks": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "transport": {
                  "const": "cli"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "git.status",
                      "git.diff",
                      "change.read",
                      "change.diff",
                      "task.read",
                      "task.search",
                      "git.commit",
                      "git.push",
                      "change.publish",
                      "task.transition",
                      "task.comment"
                    ]
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "args": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "args"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "provider",
                "transport",
                "command"
              ]
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "transport": {
                  "const": "mcp"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "git.status",
                      "git.diff",
                      "change.read",
                      "change.diff",
                      "task.read",
                      "task.search",
                      "git.commit",
                      "git.push",
                      "change.publish",
                      "task.transition",
                      "task.comment"
                    ]
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "type": "string",
                        "minLength": 1
                      },
                      "arguments": {
                        "type": "object"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "tool",
                      "arguments"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "provider",
                "transport"
              ]
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "permissions": {
      "type": "object",
      "properties": {
        "writeOperations": {
          "type": "array",
          "items": {
            "enum": [
              "git.commit",
              "git.push",
              "change.publish",
              "task.transition",
              "task.comment"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "execution": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "object",
          "properties": {
            "locator": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "main",
                    "delegate",
                    "tool"
                  ]
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "mode"
              ]
            },
            "researcher": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "main",
                    "delegate",
                    "tool"
                  ]
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "mode"
              ]
            },
            "implementer": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "main",
                    "delegate",
                    "tool"
                  ]
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "mode"
              ]
            },
            "reviewer": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "main",
                    "delegate",
                    "tool"
                  ]
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "mode"
              ]
            },
            "planner": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "main",
                    "delegate",
                    "tool"
                  ]
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "mode"
              ]
            },
            "verifier": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "main",
                    "delegate",
                    "tool"
                  ]
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "mode"
              ]
            }
          },
          "additionalProperties": false,
          "required": []
        },
        "hosts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "delegation": {
                "type": "boolean"
              },
              "models": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mainModelSwitch": {
                "type": "boolean",
                "description": "Explicit host support declaration; never grants permission to switch models."
              },
              "contextLimits": {
                "type": "object",
                "maxProperties": 16,
                "description": "Context limits by exact host model name, over the bundled host table. windowTokens applies only when the host reports no window; budgetTokens is an optional working budget past which advice suggests resuming from the checkpoint in a new session.",
                "propertyNames": {
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "windowTokens": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "budgetTokens": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            },
            "additionalProperties": false,
            "required": []
          }
        },
        "profiles": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "capabilities"
            ],
            "additionalProperties": false,
            "properties": {
              "capabilities": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "maxAttempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "escalateTo": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "enum": [
                  "economical",
                  "standard",
                  "strong"
                ]
              }
            }
          }
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "readOnly": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "readOnly"
      ]
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "promptHints": {
          "type": "boolean",
          "default": true,
          "description": "Routing hints on prompts. Set false to keep the request's intent as session state without showing a hint."
        },
        "editHints": {
          "type": "boolean",
          "default": true
        },
        "dedupeHints": {
          "type": "boolean",
          "default": true,
          "description": "Session-scoped routing hint hash state; no prompts or evidence are stored. Set false to disable."
        },
        "standardChecks": {
          "type": "boolean",
          "default": true,
          "description": "Deterministic anchor checks after an edit or commit in a declared standard's scope. Set false to keep standards in routes without checking."
        }
      }
    },
    "efficiency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lookup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "reuse": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "batching": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "maxConcurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "default": 3
            }
          }
        },
        "attempts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "maxAttempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 3
            }
          }
        },
        "advice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "at": {
              "enum": [
                "meaningful-boundaries"
              ],
              "default": "meaningful-boundaries"
            },
            "nextStep": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "manual",
                "recommend",
                "execute-when-authorized"
              ],
              "default": "recommend"
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "elevatedAt": {
