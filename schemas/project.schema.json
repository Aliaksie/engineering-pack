{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consumer project configuration v1",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "languages": {
      "type": "array",
      "items": {
        "enum": [
          "javascript",
          "typescript",
          "python",
          "jvm",
          "csharp",
          "go",
          "java",
          "kotlin"
        ]
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "enum": [
          "ui",
          "backend",
          "agent"
        ]
      }
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "languages": {
            "type": "array",
            "items": {
              "enum": [
                "javascript",
                "typescript",
                "python",
                "jvm",
                "csharp",
                "go",
                "java",
                "kotlin"
              ]
            }
          },
          "layers": {
            "type": "array",
            "items": {
              "enum": [
                "ui",
                "backend",
                "agent"
              ]
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "frameworks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "command"
              ]
            }
          },
          "runtimes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "path"
        ]
      }
    },
    "services": {
      "type": "object",
      "properties": {
        "git": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "transport": {
                  "const": "cli"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "git.status",
                      "git.diff",
                      "change.read",
                      "change.diff",
                      "task.read",
                      "task.search",
                      "git.commit",
                      "git.push",
                      "change.publish",
                      "task.transition",
                      "task.comment"
                    ]
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "args": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "args"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "provider",
                "transport",
                "command"
              ]
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "transport": {
                  "const": "mcp"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "git.status",
                      "git.diff",
                      "change.read",
                      "change.diff",
                      "task.read",
                      "task.search",
                      "git.commit",
                      "git.push",
                      "change.publish",
                      "task.transition",
                      "task.comment"
                    ]
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "type": "string",
                        "minLength": 1
                      },
                      "arguments": {
                        "type": "object"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "tool",
                      "arguments"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "provider",
                "transport"
              ]
            }
          ]
        },
        "codehost": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "transport": {
                  "const": "cli"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "git.status",
                      "git.diff",
                      "change.read",
                      "change.diff",
                      "task.read",
                      "task.search",
                      "git.commit",
                      "git.push",
                      "change.publish",
                      "task.transition",
                      "task.comment"
                    ]
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "args": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "args"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "provider",
                "transport",
                "command"
              ]
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "transport": {
                  "const": "mcp"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "git.status",
                      "git.diff",
                      "change.read",
                      "change.diff",
                      "task.read",
                      "task.search",
                      "git.commit",
                      "git.push",
                      "change.publish",
                      "task.transition",
                      "task.comment"
                    ]
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "type": "string",
                        "minLength": 1
                      },
                      "arguments": {
                        "type": "object"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "tool",
                      "arguments"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "provider",
                "transport"
              ]
            }
          ]
        },
        "tasks": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "transport": {
                  "const": "cli"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "git.status",
                      "git.diff",
                      "change.read",
                      "change.diff",
                      "task.read",
                      "task.search",
                      "git.commit",
                      "git.push",
                      "change.publish",
                      "task.transition",
                      "task.comment"
                    ]
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "args": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "args"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "provider",
                "transport",
                "command"
              ]
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "transport": {
                  "const": "mcp"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "git.status",
                      "git.diff",
                      "change.read",
                      "change.diff",
                      "task.read",
                      "task.search",
                      "git.commit",
                      "git.push",
                      "change.publish",
                      "task.transition",
                      "task.comment"
                    ]
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "type": "string",
                        "minLength": 1
                      },
                      "arguments": {
                        "type": "object"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "tool",
                      "arguments"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "provider",
                "transport"
              ]
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "permissions": {
      "type": "object",
      "properties": {
        "writeOperations": {
          "type": "array",
          "items": {
            "enum": [
              "git.commit",
              "git.push",
              "change.publish",
              "task.transition",
              "task.comment"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "execution": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "object",
          "properties": {
            "locator": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "main",
                    "delegate",
                    "tool"
                  ]
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "mode"
              ]
            },
            "researcher": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "main",
                    "delegate",
                    "tool"
                  ]
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "mode"
              ]
            },
            "implementer": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "main",
                    "delegate",
                    "tool"
                  ]
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "mode"
              ]
            },
            "reviewer": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "main",
                    "delegate",
                    "tool"
                  ]
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "mode"
              ]
            },
            "planner": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "main",
                    "delegate",
                    "tool"
                  ]
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "mode"
              ]
            },
            "verifier": {
              "type": "object",
              "properties": {
                "mode": {
                  "enum": [
                    "main",
                    "delegate",
                    "tool"
                  ]
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "mode"
              ]
            }
          },
          "additionalProperties": false,
          "required": []
        },
        "hosts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "delegation": {
                "type": "boolean"
              },
              "models": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mainModelSwitch": {
                "type": "boolean",
                "description": "Explicit host support declaration; never grants permission to switch models."
              },
              "contextLimits": {
                "type": "object",
                "maxProperties": 16,
                "description": "Context limits by exact host model name, over the bundled host table. windowTokens applies only when the host reports no window; budgetTokens is an optional working budget past which advice suggests resuming from the checkpoint in a new session.",
                "propertyNames": {
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "windowTokens": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "budgetTokens": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            },
            "additionalProperties": false,
            "required": []
          }
        },
        "profiles": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "capabilities"
            ],
            "additionalProperties": false,
            "properties": {
              "capabilities": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "maxAttempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "escalateTo": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "enum": [
                  "economical",
                  "standard",
                  "strong"
                ]
              }
            }
          }
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "readOnly": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "readOnly"
      ]
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "editHints": {
          "type": "boolean",
          "default": true
        },
        "dedupeHints": {
          "type": "boolean",
          "default": true,
          "description": "Session-scoped routing hint hash state; no prompts or evidence are stored. Set false to disable."
        }
      }
    },
    "efficiency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lookup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "reuse": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "batching": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "maxConcurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "default": 3
            }
          }
        },
        "attempts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "maxAttempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 3
            }
          }
        },
        "advice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "at": {
              "enum": [
                "meaningful-boundaries"
              ],
              "default": "meaningful-boundaries"
            },
            "nextStep": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "manual",
                "recommend",
                "execute-when-authorized"
              ],
              "default": "recommend"
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "elevatedAt": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "default": 0.6
            },
            "compactAt": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "default": 0.75
            },
            "restartAt": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "default": 0.85
            },
            "action": {
              "enum": [
                "manual",
                "recommend",
                "execute-when-authorized"
              ],
              "default": "recommend"
            }
          }
        },
        "delegation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "manual",
                "recommend",
                "execute-when-authorized"
              ],
              "default": "recommend"
            },
            "maxWorkers": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "default": 3
            }
          }
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxSessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "scratch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "staleAfterHours": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8760
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "maxFiles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "retentionDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "maxArtifacts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "description": "Project Intelligence inventory scope.",
      "properties": {
        "exclude": {
          "type": "array",
          "maxItems": 64,
          "description": "Project-relative path prefixes left out of the evidence inventory, such as generated samples or vendored bundles. Whole path components; a trailing / is accepted.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "formatVersion"
  ]
}
