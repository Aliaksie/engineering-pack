{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable playbook catalog v1",
  "description": "Structural authoring contract. Runtime validation also checks cross-field identities, selector values and implied runtimes. Source validation resolves registered load targets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "intents",
    "stackIntents",
    "extensions",
    "layerExtensions",
    "runtimeImplications",
    "entries"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "stackIntents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^\\.[a-z0-9]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "layerExtensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^\\.[a-z0-9]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "runtimeImplications": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "skills",
        "references",
        "when",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(workflow|practice|language|runtime|framework|provider|layer):[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "fallbackSkills": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "additionalProperties": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*/references/(?:[a-z0-9]+(?:-[a-z0-9]+)*/)*[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "intents": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "risks": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "languages": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "runtimes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "frameworks": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "providers": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "layers": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "problem",
            "contribution",
            "inputs",
            "result",
            "boundaries",
            "consumer",
            "evidence"
          ],
          "properties": {
            "problem": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "contribution": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "inputs": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "result": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "boundaries": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "consumer": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "evidence": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "unavailable": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "documentationQuestion": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "contextOnly": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "properties": {
            "skills": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "references": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "unavailable"
          ]
        },
        {
          "required": [
            "contextOnly"
          ],
          "properties": {
            "contextOnly": {
              "const": true
            }
          }
        }
      ]
    }
  }
}
